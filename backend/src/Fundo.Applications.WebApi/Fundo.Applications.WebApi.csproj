    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <PropertyGroup>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fundo.Core\Fundo.Core.csproj" />
    <ProjectReference Include="..\Fundo.Infrastructure\Fundo.Infrastructure.csproj" />
